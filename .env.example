# Production (không có hậu tố /api)
VITE_API_HOST=https://sales.kidoedu.vn

# Development: VITE_API_HOST=http://160.250.132.143:3011

# Id của Zalo Official Account của trường (dùng cho followOA khi đăng nhập giáo viên trên Mini App)
VITE_ZALO_OA_ID=

# Socket.IO thông báo realtime dùng chung hạ tầng với VITE_API_HOST ở trên, không cần cấu hình riêng.

# Cấu hình Firebase Cloud Messaging (Firebase Console > Project settings > General > Your apps > Web app).
# Thiếu bất kỳ giá trị nào thì tính năng đăng ký FCM token sẽ tự tắt (không lỗi), Socket.IO vẫn hoạt động bình thường.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console > Project settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=
